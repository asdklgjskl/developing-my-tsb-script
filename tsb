                                        task.wait(0.2)
                                        pcall(function() comm:FireServer({Goal = "Skill", Skill = 3}) end)
                                        task.wait(0.2)
                                    end
                                end
                            end

                            if tH.Health <= 0 then
                                sessionStats.botKills = sessionStats.botKills + 1
                                sessionStats.kills = sessionStats.kills + 1
                                allTimeStats.totalBotKills = (allTimeStats.totalBotKills or 0) + 1
                                allTimeStats.totalKills = (allTimeStats.totalKills or 0) + 1
                            end
                        end
                    end
                end
            end
        end
    end
end)

