    if input.KeyCode == Enum.KeyCode.RightControl then
        menuVisible = not menuVisible
        pcall(function()
            if menuVisible then
                Window:Restore()
            else
                Window:Minimize()
            end
        end)
        -- Fallback
        pcall(function()
            for _, gui in pairs(player:FindFirstChild("PlayerGui"):GetDescendants()) do
                if gui:IsA("Frame") and gui.Name:find("WindUI") then
                    gui.Visible = menuVisible
                end
            end
        end)
        pcall(function()
            for _, gui in pairs(CoreGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name:find("WindUI") then
                    gui.Enabled = menuVisible
                end
            end
        end)
    end
end)

