-- AUTO BUY AURAS
-- ============================================
local function tryBuyAura()
    local root = getRoot()
    local hum = getHum()
    if not root or not hum or hum.Health <= 0 then return end

    local candy = player:GetAttribute("Candy") or 0
    if candy < 500 then return end

    -- Сохраняем позицию и камеру
    local oldPos = root.CFrame
    local oldCam = camera.CFrame

    -- ТП к магазину
    root.CFrame = CFrame.new(shopPos)
    task.wait(0.5)

    -- Лочим камеру если нужно
    if buyLockCamera then
        camera.CFrame = CFrame.new(shopPos + Vector3.new(0, 5, 10), shopPos)
    end

    -- Двигаем мышь на кнопку покупки
    VIM:SendMouseMoveEvent(buyMouseX, buyMouseY, game)
    task.wait(0.3)

    -- Зажимаем ЛКМ
    VIM:SendMouseButtonEvent(buyMouseX, buyMouseY, 0, true, game, 0)
    task.wait(buyHoldTime)
    VIM:SendMouseButtonEvent(buyMouseX, buyMouseY, 0, false, game, 0)

    task.wait(0.5)

    -- Возвращаемся
    root.CFrame = oldPos
    if buyLockCamera then
        camera.CFrame = oldCam
    end

    sessionAuras = sessionAuras + 1
    stats.totalAuras = stats.totalAuras + 1
    saveData()
end

local function buyLoop()
    while buyEnabled do
        pcall(tryBuyAura)
        task.wait(buyCooldown)
    end
end

