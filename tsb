-- Конфигурация
local FarmConfig = {
    AutoCandy = false,
    AutoDoors = false,
}

local SessionStats = {
    Candy = 0,
    Doors = 0,
    StartTime = os.time()
}

local PersistentStats = {
    TotalCandy = 0,
    TotalDoors = 0,
}

-- Последнее известное значение атрибута Candy (для подсчёта прироста)
local LastCandyAttribute = nil
-- Последнее значение, учтённое в PersistentStats.TotalCandy
local LastCountedCandy = nil

local isDoorBusy = false

-- ======================================================================
--  СОХРАНЕНИЕ / ЗАГРУЗКА
-- ======================================================================

local DATA_FOLDER = "HalloweenFarmData"
local DATA_FILE = DATA_FOLDER .. "/stats_v1.json"

local function LoadStats()
    if isfolder and not isfolder(DATA_FOLDER) then
        makefolder(DATA_FOLDER)
    end
    if isfile and isfile(DATA_FILE) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(DATA_FILE))
        end)
        if success and type(result) == "table" then
            PersistentStats.TotalCandy = result.TotalCandy or 0
            PersistentStats.TotalDoors = result.TotalDoors or 0
        end
    end
end

local function SaveStats()
    if isfolder and not isfolder(DATA_FOLDER) then
        makefolder(DATA_FOLDER)
    end
    if writefile then
        pcall(function()
            writefile(DATA_FILE, HttpService:JSONEncode(PersistentStats))
        end)
    end
end

LoadStats()

-- ======================================================================
--  ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ======================================================================

local function IsStunned(character)
    if not character then return true end
    if character:FindFirstChild("RootAnchor") or character:FindFirstChild("NoRotate") or character:FindFirstChild("ActionLock") then
        return true
    end
    return false
end

local function FormatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

-- ======================================================================
--  ЧТЕНИЕ КОНФЕТ ИЗ АТРИБУТА
-- ======================================================================

-- Возвращает текущее значение атрибута Candy у LocalPlayer (0 если nil)
local function GetCandyAttribute()
    local value = LocalPlayer:GetAttribute("Candy")
    if type(value) == "number" then
        return value
    end
    return 0
end

-- Синхронизирует статистику конфет с атрибутом
local function SyncCandyStats()
    local current = GetCandyAttribute()

    if LastCountedCandy == nil then
        -- Первый запуск: фиксируем текущее значение как отправную точку
        LastCountedCandy = current
        LastCandyAttribute = current
        return
    end

    if current > LastCountedCandy then
        local delta = current - LastCountedCandy
        SessionStats.Candy = SessionStats.Candy + delta
        PersistentStats.TotalCandy = PersistentStats.TotalCandy + delta
        LastCountedCandy = current
        SaveStats()
    elseif current < LastCountedCandy then
        -- Атрибут уменьшился (например, после сброса/перезахода) — просто пересинхронизируем
        LastCountedCandy = current
    end

    LastCandyAttribute = current
end

-- ======================================================================
--  АВТОМАТИЧЕСКОЕ ОТКРЫТИЕ ДВЕРЕЙ
-- ======================================================================

local function FarmDoorsStep()
    if not FarmConfig.AutoDoors or isDoorBusy then return end
    local char = LocalPlayer.Character
    if not char or IsStunned(char) then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local doorsFolder = Workspace:FindFirstChild("HalloweenDoorTrees")
    if not doorsFolder then return end

    local targetPrompt = nil
    local minDist = math.huge

    for _, tree in ipairs(doorsFolder:GetChildren()) do
        local door = tree:FindFirstChild("DOOR 1 NEW") or tree:FindFirstChildOfClass("Model")
        if door then
            local frame = door:FindFirstChild("Frame")
            if frame then
                local prompt = frame:FindFirstChildOfClass("ProximityPrompt") or frame:FindFirstChild("TrickOrTreat")
                if prompt and prompt.Enabled then
                    local dist = (hrp.Position - frame.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        targetPrompt = prompt
                    end
                end
            end
        end
    end

    if targetPrompt and targetPrompt.Parent then
        isDoorBusy = true
        local frame = targetPrompt.Parent

        hrp.CFrame = frame.CFrame * CFrame.new(0, 0, 3)
        task.wait(0.3)

        if fireproximityprompt then
            fireproximityprompt(targetPrompt)
        else
            targetPrompt:InputHoldBegin()
            task.wait(targetPrompt.HoldDuration or 0.5)
            targetPrompt:InputHoldEnd()
        end

        -- Ожидание появления RootAnchor (признак того, что взаимодействие началось)
        local appeared = false
        local t0 = tick()
        while tick() - t0 < 3 do
            local curChar = LocalPlayer.Character
            if curChar and curChar:FindFirstChild("RootAnchor") then
                appeared = true
                break
            end
            task.wait(0.1)
        end

        -- Ожидание исчезновения RootAnchor (признак завершения открытия двери)
        local finished = false
        if appeared then
            local t1 = tick()
            while tick() - t1 < 15 do
                local curChar = LocalPlayer.Character
                if curChar and not curChar:FindFirstChild("RootAnchor") then
                    finished = true
                    break
                end
                task.wait(0.1)
            end
        end

        -- Статистика двери засчитывается только если цикл действительно завершился
        if appeared and finished then
            SessionStats.Doors = SessionStats.Doors + 1
            PersistentStats.TotalDoors = PersistentStats.TotalDoors + 1
            SaveStats()
        end

        task.wait(1.0)
        isDoorBusy = false
    end
end

-- ======================================================================
--  ЦИКЛЫ ВЫПОЛНЕНИЯ
-- ======================================================================

task.spawn(function()
    while task.wait(0.5) do
        if FarmConfig.AutoDoors then
            pcall(FarmDoorsStep)
        end
    end
end)

-- Периодическая синхронизация конфет с атрибутом
task.spawn(function()
    while task.wait(0.5) do
        pcall(SyncCandyStats)
    end
end)

