local function getAlivePlayers()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function getLiveNPCs()
    local list = {}
    local live = Workspace:FindFirstChild("Live")
    if live then
        for _, npc in pairs(live:GetChildren()) do
            local h = npc:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                table.insert(list, npc)
            end
        end
    end
    return list
end

local function findClosestDoor()
    local trees = Workspace:FindFirstChild("HalloweenDoorTrees")
    if not trees then return nil, nil end
    local best = nil
    local bestDist = 99999
    local bestPrompt = nil
    for _, tree in pairs(trees:GetChildren()) do
        local door = tree:FindFirstChild("DOOR 1 NEW")
        if door then
            local frame = door:FindFirstChild("Frame")
            if frame then
                local prompt = frame:FindFirstChild("TrickOrTreat")
                if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    local pos = prompt.Parent.Position
                    local d = distTo(pos)
                    if d < bestDist then
                        bestDist = d
                        best = pos
                        bestPrompt = prompt
                    end
                end
            end
        end
    end
    return best, bestPrompt
end

local function findClosestZombie()
    local live = Workspace:FindFirstChild("Live")
    if not live then return nil, nil end
    local best = nil
    local bestDist = 99999
    local bestModel = nil
    for _, npc in pairs(live:GetChildren()) do
        local name = npc.Name:lower()
        if name:find("zombie") or name:find("halloween") then
            if not name:find("dummy") and not name:find("shopkeeper") and not name:find("giver") then
                local h = npc:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = distTo(hrp.Position)
                        if d < bestDist then
                            bestDist = d
                            best = hrp.Position
                            bestModel = npc
                        end
                    end
                end
            end
        end
    end
    return best, bestModel
end

local function findClosestCandy()
    local folder = Workspace:FindFirstChild("HalloweenCandy")
    if not folder then return nil end
    local best = nil
    local bestDist = 99999
    for _, candy in pairs(folder:GetChildren()) do
        if candy:IsA("BasePart") then
            local rest = candy:GetAttribute("Rest")
            if rest then
                local pos = rest.Position
                local d = distTo(pos)
                if d < bestDist then
                    bestDist = d
                    best = pos
                end
            end
        end
    end
    return best
end

local function findBoss()
    local live = Workspace:FindFirstChild("Live")
    if not live then return nil, nil end
    for _, npc in pairs(live:GetChildren()) do
        local name = npc.Name:lower()
        if name:find("boss") or name:find("headless") or name:find("pumpkin king") then
            local h = npc:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    return hrp.Position, npc
                end
            end
        end
    end
    return nil, nil
end

