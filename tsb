-- ============================================
-- ROLL EMOTES SYSTEM
-- ============================================
local function findSpinButton()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local emotes = pg:FindFirstChild("Emotes")
    if not emotes then return nil end
    local img = emotes:FindFirstChild("ImageLabel")
    if not img then return nil end
    local spin = img:FindFirstChild("Spin")
    if not spin then return nil end
    return spin
end

local function findRollRemote()
    -- Ищем Remote для ролла в ReplicatedStorage
    for _, v in ReplicatedStorage:GetDescendants() do
        local n = v.Name:lower()
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            if n:find("roll") or n:find("emote") or n:find("spin") or n:find("gacha") then
                return v
            end
        end
    end
    -- Ищем в других местах
    for _, v in game:GetDescendants() do
        local n = v.Name:lower()
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            if (n:find("roll") or n:find("emote") or n:find("spin"))
               and not n:find("replication")
               and not n:find("catalogue") then
                return v
            end
        end
    end
    return nil
end

local function doRoll()
    -- Способ 1: firesignal на Spin кнопку (самый надёжный)
    local spinBtn = findSpinButton()
    if spinBtn and firesignal then
        pcall(function()
            firesignal(spinBtn.MouseButton1Click)
        end)
        print("🎲 Ролл через firesignal(Spin.MouseButton1Click)")
        WindUI:Notify({Title = "🎲 Ролл эмоций!", Desc = "firesignal на Spin кнопку", Duration = 3})
        return
    end

    -- Способ 2: Remote
    if not rollRemote then
        rollRemote = findRollRemote()
    end
    if rollRemote then
        pcall(function()
            if rollRemote:IsA("RemoteEvent") then
                rollRemote:FireServer()
            elseif rollRemote:IsA("RemoteFunction") then
                rollRemote:InvokeServer()
            end
        end)
        print("🎲 Ролл через Remote:", rollRemote.Name)
        WindUI:Notify({Title = "🎲 Ролл эмоций!", Desc = "Remote: " .. rollRemote.Name, Duration = 3})
        return
    end

    -- Способ 3: Клик по координатам Spin кнопки
    if spinBtn then
        local pos = spinBtn.AbsolutePosition
        local size = spinBtn.AbsoluteSize
        local cx = pos.X + size.X / 2
        local cy = pos.Y + size.Y / 2
        VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.15)
        VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        print("🎲 Ролл через клик по Spin:", cx, cy)
        WindUI:Notify({Title = "🎲 Ролл эмоций!", Desc = "Клик по Spin кнопке", Duration = 3})
        return
    end

    -- Способ 4: Ручные координаты мыши
    if rollMouseX > 0 and rollMouseY > 0 then
        VIM:SendMouseButtonEvent(rollMouseX, rollMouseY, 0, true, game, 0)
        task.wait(0.15)
        VIM:SendMouseButtonEvent(rollMouseX, rollMouseY, 0, false, game, 0)
        print("🎲 Ролл через ручные координаты:", rollMouseX, rollMouseY)
        WindUI:Notify({Title = "🎲 Ролл эмоций!", Desc = "Клик по координатам", Duration = 3})
        return
    end

    print("⚠️ Не удалось сделать ролл — не найдена Spin кнопка и нет координат!")
    WindUI:Notify({Title = "⚠️ Ролл не удался", Desc = "Не найдена кнопка Spin", Duration = 3})
end

local function checkRoll()
    if botKillCount > 0 and botKillCount % rollEveryKills == 0 then
        task.spawn(doRoll)
    end
end

