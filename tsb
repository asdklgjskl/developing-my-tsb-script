        if math.floor(elapsed) % 10 == 0 then
            saveData()
        end

        local t = math.floor(elapsed)
        local h = math.floor(t / 3600)
        local m = math.floor((t % 3600) / 60)
        local s = t % 60

        pcall(function()
            statAllTime:SetDesc(string.format(
                "⏱ %ds | 🍬 %d | 💀 %d | 🚪 %d | ✨ %d | 🚀 %d",
                stats.totalTime or 0,
                stats.totalCandy or 0,
                stats.totalKills or 0,
                stats.totalDoors or 0,
                stats.totalAuras or 0,
                stats.launches or 0
            ))

            statSession:SetDesc(string.format(
                "⏱ %02d:%02d:%02d | 🍬 %d | 💀 %d | 🚪 %d | ✨ %d",
                h, m, s,
                sessionCandy,
                sessionKills,
                sessionDoors,
                sessionAuras
            ))

            botCountPara:SetDesc(string.format(
                "💀 %d убито | 🎲 Следующий ролл через: %d киллов",
