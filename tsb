local function safeNum(v, def)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) or (def or 0) end
    return def or 0
end

local function safeLen(v)
    if type(v) == "table" then return #v end
    if type(v) == "string" then return #v end
    return 0
end

local function getAttr(name, def)
    local v = player:GetAttribute(name)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) or (def or 0) end
    return def or 0
end

local function getRoot()
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
    end
    return nil
end

local function getHumanoid()
    local char = player.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then return h end
    end
    return nil
end

local function isBusy()
    local char = player.Character
    if not char then return false end
    if char:FindFirstChild("RootAnchor") then return true end
    if char:FindFirstChild("NoRotate") then return true end
    if char:FindFirstChild("ActionLock") then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if hrp:FindFirstChild("RootAnchor") then return true end
        if hrp:FindFirstChild("NoRotate") then return true end
        if hrp:FindFirstChild("ActionLock") then return true end
    end
    return false
end

local function tpTo(pos)
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(pos)
    end
end

local function distTo(pos)
    local root = getRoot()
    if root then
        return (root.Position - pos).Magnitude
    end
    return 99999
end

