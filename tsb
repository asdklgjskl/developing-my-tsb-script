local function buyAura()
    local candy = getAttr("Candy", 0)
    if candy < 500 then
        WindUI:Notify({Title = "🛒 Покупка", Content = "Нужно 500 кэнди (сейчас: " .. tostring(candy) .. ")", Duration = 3})
        return
    end

    -- Сохраняем и паузим все фармы
    local saved = {
        candy = state.autoFarmCandy,
        doors = state.autoFarmDoors,
        zombies = state.autoFarmZombies,
        boss = state.autoFarmBoss,
        botKill = state.botKillActive,
        punch = state.autoPunch,
        skill = state.autoSkill,
    }
    state.autoFarmCandy = false
    state.autoFarmDoors = false
    state.autoFarmZombies = false
    state.autoFarmBoss = false
    state.botKillActive = false
    state.autoPunch = false
    state.autoSkill = false
    state.autoBuyActive = true

    WindUI:Notify({Title = "🛒 Покупка", Content = "Телепорт к шопу...", Duration = 2})

    -- ТП к шопу
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(562.0, 447.0, -440.3)
    end
    task.wait(2.5)

    local bought = false
    local candyBefore = getAttr("Candy", 0)

    -- ══════════════════════════════════════════
    -- СТРАТЕГИЯ 1: RemoteEvent (самая надёжная)
    -- ══════════════════════════════════════════
    pcall(function()
        local remoteNames = {"shop", "buy", "purchase", "aura", "store", "redeem", "hallo", "event", "candy", "trade"}
        local allRemotes = {}
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                for _, keyword in pairs(remoteNames) do
                    if n:find(keyword) then
                        table.insert(allRemotes, v)
                        break
                    end
                end
            end
        end
        print("[BUY] Найдено RemoteEvents: " .. tostring(#allRemotes))
        for _, rem in pairs(allRemotes) do
            print("[BUY] Пробуем: " .. rem:GetFullName())
            pcall(function() rem:FireServer("Buy") end)
            task.wait(0.3)
            pcall(function() rem:FireServer("Aura") end)
            task.wait(0.3)
            pcall(function() rem:FireServer("Purchase", "Aura") end)
            task.wait(0.3)
            pcall(function() rem:FireServer("BuyAura") end)
            task.wait(0.3)
            pcall(function() rem:FireServer(500) end)
            task.wait(0.3)
        end
    end)
    task.wait(1)

    local newCandy = getAttr("Candy", 0)
    if newCandy < candyBefore then
        bought = true
        print("[BUY] Успех через RemoteEvent! Было: " .. tostring(candyBefore) .. " Стало: " .. tostring(newCandy))
    end

    -- ══════════════════════════════════════════
    -- СТРАТЕГИЯ 2: Кнопка в GUI
    -- ══════════════════════════════════════════
    if not bought then
        pcall(function()
            local pg = player:FindFirstChild("PlayerGui")
            if pg then
                local buttons = {}
                for _, gui in pairs(pg:GetDescendants()) do
                    if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                        local text = tostring(gui.Text or ""):lower()
                        local name = gui.Name:lower()
                        if text:find("buy") or text:find("500") or text:find("purchase")
                            or name:find("buy") or name:find("aura") or name:find("purchase") then
                            table.insert(buttons, gui)
                        end
                    end
                end
                print("[BUY] Найдено кнопок в GUI: " .. tostring(#buttons))
                for _, btn in pairs(buttons) do
                    print("[BUY] Кликаем: " .. btn:GetFullName() .. " Text=" .. tostring(btn.Text))
                    pcall(function() btn:Activate() end)
                    task.wait(0.5)
                    pcall(function()
                        if btn.MouseButton1Click then
                            btn.MouseButton1Click:Fire()
                        end
                    end)
                    task.wait(0.5)
                end
            end
        end)
        task.wait(1)
        newCandy = getAttr("Candy", 0)
        if newCandy < candyBefore then
            bought = true
            print("[BUY] Успех через GUI кнопку!")
        end
    end

    -- ══════════════════════════════════════════
    -- СТРАТЕГИЯ 3: Виртуальный клик (fallback)
    -- ══════════════════════════════════════════
    if not bought then
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local cx, cy = 954, 494
            print("[BUY] Виртуальный клик на " .. tostring(cx) .. "," .. tostring(cy))

            if type(mousemoverel) == "function" then
                pcall(function() mousemoverel(cx, cy) end)
                task.wait(0.5)
            end

            for i = 1, 15 do
                pcall(function()
                    vim:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                end)
                task.wait(0.1)
                pcall(function()
                    vim:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                end)
                task.wait(0.5)
            end
        end)
        task.wait(1)
        newCandy = getAttr("Candy", 0)
        if newCandy < candyBefore then
            bought = true
            print("[BUY] Успех через виртуальный клик!")
        end
    end

    -- ══════════════════════════════════════════
    -- Результат
    -- ══════════════════════════════════════════
    if bought then
        sessionStats.auras = sessionStats.auras + 1
        allTimeStats.totalAuras = (allTimeStats.totalAuras or 0) + 1
        WindUI:Notify({Title = "🛒 Покупка", Content = "✅ Аура куплена! Кэнди: " .. tostring(getAttr("Candy", 0)), Duration = 4})
    else
        WindUI:Notify({Title = "🛒 Покупка", Content = "⚠️ Не удалось. Скинь F9 вывод!", Duration = 5})
        print("[BUY] === ВСЕ REMOTE EVENTS ===")
        pcall(function()
            for _, v in pairs(game:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    print("[BUY] " .. v:GetFullName())
                end
            end
        end)
        print("[BUY] === КОНЕЦ ===")
    end

    -- Восстанавливаем фармы
    state.autoBuyActive = false
    state.autoFarmCandy = saved.candy
    state.autoFarmDoors = saved.doors
    state.autoFarmZombies = saved.zombies
    state.autoFarmBoss = saved.boss
    state.botKillActive = saved.botKill
    state.autoPunch = saved.punch
    state.autoSkill = saved.skill
end

