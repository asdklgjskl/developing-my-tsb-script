local function playEmoteClient(name)
    pcall(function()
        local char = player.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then return end

        if state.currentEmoteTrack then
            pcall(function() state.currentEmoteTrack:Stop() end)
        end

        local animId = nil
        pcall(function()
            if EmotesModule then
                local info = EmotesModule:GetTable(true)
                if info and info[name] then
                    animId = info[name].Animation
                end
            end
        end)

        if animId then
            local anim = Instance.new("Animation")
            anim.AnimationId = animId
            local track = animator:LoadAnimation(anim)
            track.Looped = true
            track:Play()
            state.currentEmoteTrack = track
            state.isEmoting = true
        end

        -- Звук
        pcall(function()
            if EmotesModule then
                local info = EmotesModule:GetTable(true)
                if info and info[name] and info[name].Sound then
                    local sound = Instance.new("Sound")
                    sound.SoundId = info[name].Sound
                    sound.Parent = char:FindFirstChild("HumanoidRootPart") or char
                    sound:Play()
                    game:GetService("Debris"):AddItem(sound, 10)
                end
            end
        end)
    end)
end

local function stopEmote()
    pcall(function()
        if state.currentEmoteTrack then
            state.currentEmoteTrack:Stop()
            state.currentEmoteTrack = nil
        end
        state.isEmoting = false
    end)
end

