task.spawn(function()
    while task.wait(0.3) do
        if state.botKillActive and not state.autoBuyActive then
            local targets = {}
            local allPlayers = getAlivePlayers()

            if #state.botKillTargets > 0 then
                -- Атакуем только из списка
                for _, p in pairs(allPlayers) do
                    for _, name in pairs(state.botKillTargets) do
                        if p.Name:lower() == name:lower() or p.DisplayName:lower() == name:lower() then
                            table.insert(targets, p)
                        end
                    end
                end
            else
                -- Атакуем всех кроме Shopkeeper/Giver
                for _, p in pairs(allPlayers) do
                    local n = p.Name:lower()
                    if not n:find("shopkeeper") and not n:find("giver") then
                        table.insert(targets, p)
                    end
                end
            end

            if #targets > 0 then
                -- Сортировка по дистанции
                table.sort(targets, function(a, b)
                    local aHrp = a.Character and a.Character:FindFirstChild("HumanoidRootPart")
                    local bHrp = b.Character and b.Character:FindFirstChild("HumanoidRootPart")
                    local aDist = aHrp and distTo(aHrp.Position) or 99999
                    local bDist = bHrp and distTo(bHrp.Position) or 99999
                    return aDist < bDist
                end)

                local target = targets[1]
                if target and target.Character then
                    local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
                    local tH = target.Character:FindFirstChildOfClass("Humanoid")
                    if tHrp and tH and tH.Health > 0 then
                        local root = getRoot()
                        if root then
                            root.CFrame = CFrame.new(tHrp.Position + Vector3.new(0, 3, 4))
                            task.wait(0.2)

                            local char = player.Character
                            if char then
                                local comm = char:FindFirstChild("Communicate")
                                if comm then
                                    if tH.Health < tH.MaxHealth * 0.3 then
                                        -- Добивание: только скиллы 1, 3, 4 (НЕ 2!)
                                        for _, sk in pairs({1, 3, 4}) do
                                            pcall(function() comm:FireServer({Goal = "Skill", Skill = sk}) end)
                                            task.wait(0.3)
                                        end
                                    else
