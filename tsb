-- ============================================
-- AUTO KILL ZOMBIES
-- ============================================
local function isZombieTarget(model)
    if not model:IsA("Model") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Исключаем игроков
    for _, p in Players:GetPlayers() do
        if p.Character == model then return false end
    end

    -- Исключаем NPC из чёрного списка
    if zombieBlacklist[model.Name] then return false end

    -- Только из Workspace.Live
    local live = workspace:FindFirstChild("Live")
    if not live or model.Parent ~= live then return false end

    -- Фильтр боссов
    if not targetBosses and model.Name:find("Dummy") then return false end

    return true
end

function killNearbyZombies(maxDist)
    maxDist = maxDist or 999
    local live = workspace:FindFirstChild("Live")
    if not live then return end

    local root = getRoot()
    if not root then return end

    local targets = {}
    for _, model in live:GetChildren() do
        if isZombieTarget(model) then
            local zRoot = model:FindFirstChild("HumanoidRootPart")
            if zRoot then
                local dist = (root.Position - zRoot.Position).Magnitude
                if dist <= maxDist then
                    table.insert(targets, {model = model, dist = dist})
                end
            end
        end
    end

    table.sort(targets, function(a, b) return a.dist < b.dist end)

    for _, t in targets do
        if not killEnabled and not farmEnabled then break end
        local h = t.model:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 and t.model.Parent then
            attackZombie(t.model)
            task.wait(0.3)
        end
    end
end

function attackZombie(zombie)
    local root = getRoot()
    local zRoot = zombie:FindFirstChild("HumanoidRootPart")
    local hum = zombie:FindFirstChildOfClass("Humanoid")
    if not root or not zRoot or not hum then return end

    local cx = camera.ViewportSize.X / 2
    local cy = camera.ViewportSize.Y / 2

    local maxHits = 200
    local hits = 0
    local skillCycle = 0

    while (killEnabled or farmEnabled) and hum and hum.Health > 0 and hits < maxHits do
        if not zombie.Parent or not zRoot.Parent then break end

        -- Камера на зомби
        if zRoot.Parent then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                zRoot.Position + Vector3.new(0, 2, 0)
            )
        end

        -- ТП к зомби
        if zRoot.Parent and root.Parent then
            root.CFrame = zRoot.CFrame * CFrame.new(2, 0, 5)
        end

        -- ЛКМ
        clickMouse(cx, cy)
        hits = hits + 1

        -- Скиллы каждые 3 удара: 1, 2, 3
        skillCycle = skillCycle + 1
        if skillCycle >= 3 then
            skillCycle = 0
            local sk = math.random(1, 3)
            local key = sk == 1 and Enum.KeyCode.One
                     or sk == 2 and Enum.KeyCode.Two
                     or Enum.KeyCode.Three
            pressKey(key)
            task.wait(skillDelay)
        end

        task.wait(clickDelay)
    end
end

local function killLoop()
    while killEnabled do
        local root = getRoot()
        local hum = getHum()
        if root and hum and hum.Health > 0 then
            killNearbyZombies(200)
        end
        task.wait(1.5)
    end
end

-- ============================================
-- BOT KILL SYSTEM
-- ============================================
local function isBotTarget(model)
    if not model:IsA("Model") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Исключаем себя
    if player.Character == model then return false end

    -- Исключаем NPC из блэклиста
    if zombieBlacklist[model.Name] then return false end

    -- Исключаем зомби (они в Live и имеют специфичные имена)
    if model.Name == "Halloween Zombie" then return false end
    if model.Name == "Weakest Dummy" then return false end

    return true
end

local function getBotTargets()
    if not botKillPos then return {} end

    local targets = {}

    -- Ищем в workspace (боты как Character модели)
    for _, model in workspace:GetChildren() do
        if isBotTarget(model) then
            local bRoot = model:FindFirstChild("HumanoidRootPart")
            if bRoot then
                local dist = (botKillPos - bRoot.Position).Magnitude
                if dist <= botAttackRadius then
                    table.insert(targets, {model = model, dist = dist})
                end
            end
        end
    end

    -- Также ищем в workspace.Live
    local live = workspace:FindFirstChild("Live")
    if live then
        for _, model in live:GetChildren() do
            if isBotTarget(model) then
                local bRoot = model:FindFirstChild("HumanoidRootPart")
                if bRoot then
                    local dist = (botKillPos - bRoot.Position).Magnitude
                    if dist <= botAttackRadius then
                        table.insert(targets, {model = model, dist = dist})
                    end
                end
            end
        end
    end

    table.sort(targets, function(a, b) return a.dist < b.dist end)
    return targets
end

local function attackBot(bot)
    local root = getRoot()
    local bRoot = bot:FindFirstChild("HumanoidRootPart")
    local hum = bot:FindFirstChildOfClass("Humanoid")
    if not root or not bRoot or not hum then return end

    local cx = camera.ViewportSize.X / 2
    local cy = camera.ViewportSize.Y / 2

    local maxHits = 300
    local hits = 0
    local skillCycle = 0

    while botKillEnabled and hum and hum.Health > 0 and hits < maxHits do
        if not bot.Parent or not bRoot.Parent then break end

        -- Камера на бота
        if bRoot.Parent then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                bRoot.Position + Vector3.new(0, 2, 0)
            )
        end

        -- ТП к боту
        if bRoot.Parent and root.Parent then
            root.CFrame = bRoot.CFrame * CFrame.new(2, 0, 5)
        end

        -- Определяем добивание (HP < 30%)
        local isFinishing = hum.Health < (hum.MaxHealth * 0.3)

        -- ЛКМ
        clickMouse(cx, cy)
        hits = hits + 1

        -- Скиллы каждые 4 удара
        skillCycle = skillCycle + 1
        if skillCycle >= 4 then
            skillCycle = 0

            if isFinishing then
                -- ДОБИВАНИЕ: только 1, 3, 4 (БЕЗ 2 — долгая анимация!)
                local sk = math.random(1, 3)
                local key = sk == 1 and Enum.KeyCode.One
                         or sk == 2 and Enum.KeyCode.Three
                         or Enum.KeyCode.Four
                pressKey(key)
            else
                -- ОБЫЧНАЯ АТАКА: 1, 2, 3, 4
                local sk = math.random(1, 4)
                local key = sk == 1 and Enum.KeyCode.One
                         or sk == 2 and Enum.KeyCode.Two
                         or sk == 3 and Enum.KeyCode.Three
                         or Enum.KeyCode.Four
                pressKey(key)
            end
            task.wait(skillDelay)
        end

        task.wait(clickDelay)
    end

    -- Бот убит — считаем
    if hum and hum.Health <= 0 then
        botKillCount = botKillCount + 1
        print("💀 Бот убит! Всего:", botKillCount)
        checkRoll()
    end
end

local function botKillLoop()
    while botKillEnabled do
        local root = getRoot()
        local hum = getHum()

        if not root or not hum or hum.Health <= 0 then
            task.wait(1)
            continue
        end

        -- Держим ТП на позицию ботов
        if botKillPos then
            root.CFrame = CFrame.new(botKillPos + Vector3.new(0, 3, 0))
        end

        -- Ищем ботов
        local targets = getBotTargets()

        for _, t in targets do
            if not botKillEnabled then break end

            local model = t.model
            local bRoot = model:FindFirstChild("HumanoidRootPart")
            local bHum = model:FindFirstChildOfClass("Humanoid")
            if not bRoot or not bHum or bHum.Health <= 0 then continue end

            -- Проверяем бессмертие (2.5 сек после первого обнаружения)
            if not botSeenTimes[model] then
                botSeenTimes[model] = tick()
                print("👁️ Бот обнаружен:", model.Name, "| Ждём", botImmunityTime, "сек бессмертия...")
            end

            local timeSinceSeen = tick() - botSeenTimes[model]
            if timeSinceSeen < botImmunityTime then
                -- Ещё бессмертие — ждём оставшееся время
                local remaining = botImmunityTime - timeSinceSeen
                print("⏳ Бессмертие:", string.format("%.1f", remaining), "сек")
                task.wait(remaining)
            end

            -- Проверяем снова что жив после ожидания
            if bHum.Health > 0 and model.Parent then
                attackBot(model)
            end

            -- Чистим мёртвых из таблицы
            if not model.Parent or bHum.Health <= 0 then
                botSeenTimes[model] = nil
            end
        end

        -- Чистим таблицу от удалённых моделей
        for model, _ in botSeenTimes do
            if not model.Parent then
                botSeenTimes[model] = nil
            end
        end

        task.wait(0.8)
    end
end

